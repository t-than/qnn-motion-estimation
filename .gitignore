# Large or regenerable content - kept out of git
.venv/
__pycache__/
*.pyc
# HM is its own git repo; its commit is recorded in week1/HM/hm_build_info.txt
week1/HM/
# raw and prepared video, datasets
week1/data/
# sequence manifests: machine-specific absolute paths, regenerated by prepare_sequences.py
week1/sequences*.json
# bitstreams, reconstructions and HM logs (result CSVs and result.json ARE tracked)
week1/results/**/*.bin
week1/results/**/enc.log
week1/results/**/dec.log
# week 2: HM-mv worktree (rebuilt from week1/HM + week2/hm-mv.patch), motion fields,
# and per-job bitstreams, logs, ME dumps and field dumps
week2/HM-mv/
week2/mv/
week2/results/**/*.bin
week2/results/**/enc.log
week2/results/**/dec.log
week2/results/**/*.dump
week2/results/**/*.mvf
*.yuv
*.y4m
*.7z
*.zip
*.pth
*.pt
checkpoints/
