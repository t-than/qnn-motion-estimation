+/* qnn-motion-estimation project, week 2 (not part of the HM reference software).
+ * See TEncMvIO.h.
+ *
+ * File formats (little-endian):
+ *
+ * --MEDumpFile / --MEReplayFile (".dump"): 16-byte header "QMED", uint32 version = 1,
+ *   uint32 record size = 32, uint32 reserved = 0; then one 32-byte record per call to
+ *   xMotionEstimation():
+ *     int32 POC, int32 reference POC,
+ *     int16 flags (bit 0: list L1, bit 1: bi-prediction refinement), int16 reference index,
+ *     int16 x, y, width, height       block position and size in luma samples,
+ *     int16 pred_x, pred_y            AMVP predictor the search started from, quarter-pel,
+ *     int16 int_x, int_y              result of the integer search, integer pel,
+ *     int16 mv_x, mv_y                final vector after half/quarter-pel refinement, quarter-pel.
+ *
+ * --MVFieldDumpFile / --MVFieldFile (".mvf"): 24-byte header "QMVF", uint32 version = 1,
+ *   width, height, grid = 4, number of entries; then per entry: int32 POC, int32 reference POC,
+ *   and ceil(height/4) x ceil(width/4) cells in raster order, each int16 mv_x, int16 mv_y
+ *   (quarter-pel), int16 confidence (0 = no vector, 1..1000; the dump writes 1000).
+ */
+
+#include "TEncMvIO.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <sstream>
+
+#include "TLibCommon/TComPic.h"
+#include "TLibCommon/TComDataCU.h"
+#include "TLibCommon/TComRom.h"
+
+namespace
+{
+const Int  ME_RECORD_BYTES    = 32;
+const Int  ME_HEADER_BYTES    = 16;
+const Int  FIELD_GRID         = 4;
+const Int  FIELD_HEADER_BYTES = 24;
+const Int  FIELD_CONF_CODED   = 1000;
+
+[[noreturn]] Void fail(const std::string& msg)
+{
+  fflush(stdout);
+  fprintf(stderr, "\nHM-mv error: %s\n", msg.c_str());
+  exit(EXIT_FAILURE);
+}
+
+Void putU32(UChar* p, UInt v)  { for (Int i = 0; i < 4; i++) p[i] = UChar((v >> (8 * i)) & 0xff); }
+Void putI32(UChar* p, Int v)   { putU32(p, UInt(v)); }
+Void putI16(UChar* p, Int v)
+{
+  if (v < -32768 || v > 32767)
+  {
+    fail("value out of int16 range in a motion-vector file");
+  }
+  const UInt u = UInt(v) & 0xffff;
+  p[0] = UChar(u & 0xff);
+  p[1] = UChar(u >> 8);
+}
+UInt getU32(const UChar* p)    { return UInt(p[0]) | (UInt(p[1]) << 8) | (UInt(p[2]) << 16) | (UInt(p[3]) << 24); }
+Int  getI32(const UChar* p)    { return Int(getU32(p)); }
+Int  getI16(const UChar* p)    { return Int(Short(UShort(UInt(p[0]) | (UInt(p[1]) << 8)))); }
+
+FILE* openFile(const std::string& path, const char* mode, const char* option)
+{
+  FILE* f = fopen(path.c_str(), mode);
+  if (f == NULL)
+  {
+    fail(std::string("cannot open ") + option + " file '" + path + "'");
+  }
+  setvbuf(f, NULL, _IOFBF, 1 << 20);
+  return f;
+}
+
+Void writeOrFail(FILE* f, const Void* data, size_t bytes)
+{
+  if (fwrite(data, 1, bytes, f) != bytes)
+  {
+    fail("write error in a motion-vector file (disk full?)");
+  }
+}
+
+std::string describeCall(Int poc, Int refPoc, Int flags, Int refIdx, Int x, Int y, Int w, Int h, Int px, Int py)
+{
+  std::ostringstream s;
+  s << "POC " << poc << " -> " << refPoc << " (list " << (flags & 1) << (flags & 2 ? ", bi" : "")
+    << ", ref " << refIdx << "), block " << w << "x" << h << " at (" << x << "," << y
+    << "), predictor (" << px << "," << py << ")";
+  return s.str();
+}
