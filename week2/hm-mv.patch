+TEncMvIO::TEncMvIO()
+: m_mode(MODE_NONE)
+, m_meDump(NULL)
+, m_meRecords(0)
+, m_replay(NULL)
+, m_replayRecords(0)
+, m_fieldDump(NULL)
+, m_fieldHeaderDone(false)
+, m_fieldWidth(0)
+, m_fieldHeight(0)
+, m_fieldEntries(0)
+, m_inWidth(0)
+, m_inHeight(0)
+, m_inSizeChecked(false)
+, m_fieldHits(0)
+, m_fieldMisses(0)
+, m_seedSet(false)
+{
+}
+
+TEncMvIO::~TEncMvIO()
+{
+  close();
+}
+
+Void TEncMvIO::open(const MvIoConfig& cfg)
+{
+  m_cfg = cfg;
+
+  if (m_cfg.mvRefs != "first" && m_cfg.mvRefs != "all")
+  {
+    fail("--MVRefs must be 'first' or 'all', not '" + m_cfg.mvRefs + "'");
+  }
+  if (m_cfg.mvMode == "replace")
+  {
+    m_mode = MODE_REPLACE;
+  }
+  else if (m_cfg.mvMode == "seed")
+  {
+    m_mode = MODE_SEED;
+  }
+  else if (!m_cfg.mvMode.empty())
+  {
+    fail("--MVMode must be 'replace' or 'seed', not '" + m_cfg.mvMode + "'");
+  }
+  if (m_cfg.mvFieldFile.empty() != (m_mode == MODE_NONE))
+  {
+    fail("--MVFieldFile and --MVMode go together: give both or neither");
+  }
+  if (m_cfg.mvSeedCentre && m_mode != MODE_SEED)
+  {
+    fail("--MVSeedCentre needs --MVMode=seed");
+  }
+  if (!m_cfg.meReplayFile.empty() && !m_cfg.mvFieldFile.empty())
+  {
+    fail("--MEReplayFile and --MVFieldFile can't be combined");
+  }
+
+  if (!m_cfg.meDumpFile.empty())
+  {
+    m_meDump = openFile(m_cfg.meDumpFile, "wb", "--MEDumpFile");
+    UChar header[ME_HEADER_BYTES];
+    memcpy(header, "QMED", 4);
+    putU32(header + 4, 1);
+    putU32(header + 8, ME_RECORD_BYTES);
+    putU32(header + 12, 0);
+    writeOrFail(m_meDump, header, sizeof(header));
+  }
+  if (!m_cfg.meReplayFile.empty())
+  {
+    m_replay = openFile(m_cfg.meReplayFile, "rb", "--MEReplayFile");
+    UChar header[ME_HEADER_BYTES];
+    if (fread(header, 1, sizeof(header), m_replay) != sizeof(header) || memcmp(header, "QMED", 4) != 0
+        || getU32(header + 4) != 1 || getU32(header + 8) != UInt(ME_RECORD_BYTES))
+    {
+      fail("--MEReplayFile '" + m_cfg.meReplayFile + "' is not a version-1 .dump file");
+    }
+  }
+  if (!m_cfg.mvFieldDumpFile.empty())
+  {
+    m_fieldDump = openFile(m_cfg.mvFieldDumpFile, "wb", "--MVFieldDumpFile");
+    // The header is written with the first picture, when the picture size is known.
+  }
+  if (!m_cfg.mvFieldFile.empty())
+  {
+    loadField(m_cfg.mvFieldFile);
+  }
+}
+
+Void TEncMvIO::loadField(const std::string& path)
+{
+  FILE* f = openFile(path, "rb", "--MVFieldFile");
+  std::vector<UChar> data;
+  UChar buf[1 << 16];
+  size_t n;
+  while ((n = fread(buf, 1, sizeof(buf), f)) > 0)
+  {
+    data.insert(data.end(), buf, buf + n);
+  }
+  fclose(f);
+
+  if (data.size() < size_t(FIELD_HEADER_BYTES) || memcmp(&data[0], "QMVF", 4) != 0
+      || getU32(&data[4]) != 1 || getU32(&data[16]) != UInt(FIELD_GRID))
+  {
+    fail("--MVFieldFile '" + path + "' is not a version-1 .mvf file with a 4x4 grid");
+  }
+  m_inWidth  = Int(getU32(&data[8]));
+  m_inHeight = Int(getU32(&data[12]));
+  const UInt   count  = getU32(&data[20]);
+  const size_t cells  = size_t((m_inWidth + FIELD_GRID - 1) / FIELD_GRID) * ((m_inHeight + FIELD_GRID - 1) / FIELD_GRID);
+  const size_t stride = 8 + cells * 6;
+  if (data.size() != FIELD_HEADER_BYTES + count * stride)
+  {
+    fail("--MVFieldFile '" + path + "': file size does not match its header (truncated?)");
+  }
+  for (UInt i = 0; i < count; i++)
+  {
+    const UChar* e = &data[FIELD_HEADER_BYTES + i * stride];
+    const std::pair<Int, Int> key(getI32(e), getI32(e + 4));
+    if (m_field.count(key))
+    {
+      fail("--MVFieldFile '" + path + "': duplicate entry for one (POC, reference POC) pair");
+    }
+    std::vector<Short>& v = m_field[key];
+    v.resize(cells * 3);
+    for (size_t c = 0; c < cells * 3; c++)
+    {
+      v[c] = Short(getI16(e + 8 + 2 * c));
+    }
+  }
+  printf("HM-mv: %u motion-field entries (%dx%d) read from %s, mode %s%s, references: %s\n", count,
+         m_inWidth, m_inHeight, path.c_str(), m_cfg.mvMode.c_str(), m_cfg.mvSeedCentre ? " (window centred)" : "",
+         m_cfg.mvRefs.c_str());
+}
+
+Void TEncMvIO::close()
+{
+  if (m_meDump != NULL)
+  {
+    if (fclose(m_meDump) != 0)
+    {
+      fail("cannot close the --MEDumpFile file");
+    }
+    m_meDump = NULL;
+    printf("\nHM-mv: %llu motion-search records written to %s\n", (unsigned long long)m_meRecords, m_cfg.meDumpFile.c_str());
+  }
+  if (m_replay != NULL)
+  {
+    UChar rec[ME_RECORD_BYTES];
+    const Bool leftOver = fread(rec, 1, sizeof(rec), m_replay) != 0;
+    fclose(m_replay);
+    m_replay = NULL;
+    if (leftOver)
+    {
+      fail("--MEReplayFile has more records than this encode used (was it made with more frames?)");
+    }
+    printf("\nHM-mv: %llu motion searches replayed from %s\n", (unsigned long long)m_replayRecords, m_cfg.meReplayFile.c_str());
+  }
+  if (m_fieldDump != NULL)
+  {
+    if (!m_fieldHeaderDone)
+    {
+      writeFieldHeader(0, 0);   // no inter picture was coded
+    }
+    // Patch the number of entries into the header.
+    UChar count[4];
+    putU32(count, m_fieldEntries);
+    if (fseek(m_fieldDump, FIELD_HEADER_BYTES - 4, SEEK_SET) != 0)
+    {
+      fail("cannot seek in the --MVFieldDumpFile file");
+    }
+    writeOrFail(m_fieldDump, count, sizeof(count));
+    if (fclose(m_fieldDump) != 0)
+    {
+      fail("cannot close the --MVFieldDumpFile file");
+    }
+    m_fieldDump = NULL;
+    printf("HM-mv: %u motion-field entries written to %s\n", m_fieldEntries, m_cfg.mvFieldDumpFile.c_str());
+  }
+  if (m_mode != MODE_NONE)
+  {
+    const UInt64 total = m_fieldHits + m_fieldMisses;
+    printf("HM-mv: --MVFieldFile used for %llu of %llu eligible motion searches (%.1f %%); the rest searched as usual\n",
+           (unsigned long long)m_fieldHits, (unsigned long long)total, total ? 100.0 * Double(m_fieldHits) / Double(total) : 0.0);
+    m_mode = MODE_NONE;
+  }
+}
+
+Void TEncMvIO::writeMeRecord(const TComDataCU* cu, Int partIdx, RefPicList refList, Int refIdx, Bool bi,
+                             const TComMv& pred, const TComMv& integerMv, const TComMv& finalMv)
+{
+  Int x, y, w, h;
+  cu->getPartPosition(partIdx, x, y, w, h);
+  const TComSlice* slice = cu->getSlice();
+
+  UChar rec[ME_RECORD_BYTES];
+  putI32(rec + 0, slice->getPOC());
+  putI32(rec + 4, slice->getRefPOC(refList, refIdx));
+  putI16(rec + 8, (refList == REF_PIC_LIST_1 ? 1 : 0) | (bi ? 2 : 0));
+  putI16(rec + 10, refIdx);
+  putI16(rec + 12, x);
+  putI16(rec + 14, y);
+  putI16(rec + 16, w);
+  putI16(rec + 18, h);
+  putI16(rec + 20, pred.getHor());
+  putI16(rec + 22, pred.getVer());
+  putI16(rec + 24, integerMv.getHor());
+  putI16(rec + 26, integerMv.getVer());
+  putI16(rec + 28, finalMv.getHor());
+  putI16(rec + 30, finalMv.getVer());
+  writeOrFail(m_meDump, rec, sizeof(rec));
+  m_meRecords++;
+}
+
+TComMv TEncMvIO::replayIntegerMv(const TComDataCU* cu, Int partIdx, RefPicList refList, Int refIdx, Bool bi,
+                                 const TComMv& pred)
+{
+  Int x, y, w, h;
+  cu->getPartPosition(partIdx, x, y, w, h);
+  const TComSlice* slice = cu->getSlice();
+  const Int poc    = slice->getPOC();
+  const Int refPoc = slice->getRefPOC(refList, refIdx);
+  const Int flags  = (refList == REF_PIC_LIST_1 ? 1 : 0) | (bi ? 2 : 0);
+
+  UChar rec[ME_RECORD_BYTES];
+  if (fread(rec, 1, sizeof(rec), m_replay) != sizeof(rec))
+  {
+    fail("--MEReplayFile ended early, at the motion search for " +
+         describeCall(poc, refPoc, flags, refIdx, x, y, w, h, pred.getHor(), pred.getVer()) +
+         " (was it made with fewer frames?)");
+  }
+  const Bool same = getI32(rec) == poc && getI32(rec + 4) == refPoc && getI16(rec + 8) == flags
+                    && getI16(rec + 10) == refIdx && getI16(rec + 12) == x && getI16(rec + 14) == y
+                    && getI16(rec + 16) == w && getI16(rec + 18) == h
+                    && getI16(rec + 20) == pred.getHor() && getI16(rec + 22) == pred.getVer();
+  if (!same)
+  {
+    std::ostringstream s;
+    s << "--MEReplayFile is out of step with this encode at record " << m_replayRecords << ":\n  encoder:  "
+      << describeCall(poc, refPoc, flags, refIdx, x, y, w, h, pred.getHor(), pred.getVer()) << "\n  recorded: "
+      << describeCall(getI32(rec), getI32(rec + 4), getI16(rec + 8), getI16(rec + 10), getI16(rec + 12),
+                      getI16(rec + 14), getI16(rec + 16), getI16(rec + 18), getI16(rec + 20), getI16(rec + 22))
+      << "\n(the dump must come from the same encoder binary, configuration, sequence, QP and frame count)";
+    fail(s.str());
+  }
+  m_replayRecords++;
+  return TComMv(getI16(rec + 24), getI16(rec + 26));
+}
+
+TComMv TEncMvIO::toIntegerPel(const TComMv& qpel)
+{
+  TComMv mv = qpel;
+#if ME_ENABLE_ROUNDING_OF_MVS
+  mv.divideByPowerOf2(2);
+#else
+  mv >>= 2;
+#endif
+  return mv;
+}
+
+Bool TEncMvIO::fieldMv(const TComDataCU* cu, Int partIdx, RefPicList refList, Int refIdx, TComMv& mv)
+{
+  if (m_mode == MODE_NONE)
+  {
+    return false;
+  }
+  if (refList != REF_PIC_LIST_0 || (m_cfg.mvRefs == "first" && refIdx != 0))
+  {
+    return false;   // not eligible: other reference pictures are searched as usual (decision D1)
+  }
+  const TComSlice* slice = cu->getSlice();
+  if (!m_inSizeChecked)
+  {
+    const TComSPS& sps = *slice->getSPS();
+    if (Int(sps.getPicWidthInLumaSamples()) != m_inWidth || Int(sps.getPicHeightInLumaSamples()) != m_inHeight)
+    {
+      std::ostringstream s;
+      s << "--MVFieldFile is for " << m_inWidth << "x" << m_inHeight << ", but the picture is "
+        << sps.getPicWidthInLumaSamples() << "x" << sps.getPicHeightInLumaSamples();
+      fail(s.str());
+    }
+    m_inSizeChecked = true;
+  }
+
+  std::map<std::pair<Int, Int>, std::vector<Short> >::const_iterator it =
+    m_field.find(std::make_pair(slice->getPOC(), slice->getRefPOC(refList, refIdx)));
+  if (it == m_field.end())
+  {
+    m_fieldMisses++;
+    return false;
+  }
+  const std::vector<Short>& cells = it->second;
+  const Int gridW = (m_inWidth  + FIELD_GRID - 1) / FIELD_GRID;
+  const Int gridH = (m_inHeight + FIELD_GRID - 1) / FIELD_GRID;
+
+  Int x, y, w, h;
+  cu->getPartPosition(partIdx, x, y, w, h);
+  m_medianX.clear();
+  m_medianY.clear();
+  for (Int cy = y / FIELD_GRID; cy <= std::min(gridH - 1, (y + h - 1) / FIELD_GRID); cy++)
+  {
+    for (Int cx = x / FIELD_GRID; cx <= std::min(gridW - 1, (x + w - 1) / FIELD_GRID); cx++)
+    {
+      const Short* c = &cells[(size_t(cy) * gridW + cx) * 3];
+      if (c[2] > 0)
+      {
+        m_medianX.push_back(c[0]);
+        m_medianY.push_back(c[1]);
+      }
+    }
+  }
+  if (m_medianX.empty())
+  {
+    m_fieldMisses++;
+    return false;
+  }
+  // Component-wise median (decision D3); the lower middle element for an even count.
+  const size_t mid = (m_medianX.size() - 1) / 2;
+  std::nth_element(m_medianX.begin(), m_medianX.begin() + mid, m_medianX.end());
+  std::nth_element(m_medianY.begin(), m_medianY.begin() + mid, m_medianY.end());
+  mv = TComMv(m_medianX[mid], m_medianY[mid]);
+  cu->clipMv(mv);
+  m_fieldHits++;
+  return true;
+}
+
+Void TEncMvIO::writeFieldHeader(Int width, Int height)
+{
+  UChar header[FIELD_HEADER_BYTES];
+  memcpy(header, "QMVF", 4);
+  putU32(header + 4, 1);
+  putU32(header + 8, UInt(width));
+  putU32(header + 12, UInt(height));
+  putU32(header + 16, FIELD_GRID);
+  putU32(header + 20, 0);           // number of entries, patched in close()
+  writeOrFail(m_fieldDump, header, sizeof(header));
+  m_fieldHeaderDone = true;
+  m_fieldWidth  = width;
+  m_fieldHeight = height;
+}
+
+Void TEncMvIO::dumpPictureField(TComPic* pic)
+{
+  if (m_fieldDump == NULL)
+  {
+    return;
+  }
+  const TComSlice* slice = pic->getSlice(0);
+  if (slice->isIntra() || slice->getNumRefIdx(REF_PIC_LIST_0) == 0)
+  {
+    return;
+  }
+  const TComSPS& sps = *slice->getSPS();
+  const Int width  = Int(sps.getPicWidthInLumaSamples());
+  const Int height = Int(sps.getPicHeightInLumaSamples());
+  if (!m_fieldHeaderDone)
+  {
+    writeFieldHeader(width, height);
+  }
+  else if (width != m_fieldWidth || height != m_fieldHeight)
+  {
+    fail("picture size changed during the sequence; --MVFieldDumpFile needs a fixed size");
+  }
+
+  const Int gridW = (width  + FIELD_GRID - 1) / FIELD_GRID;
+  const Int gridH = (height + FIELD_GRID - 1) / FIELD_GRID;
+  const Int minPartSize = Int(sps.getMaxCUWidth() >> sps.getMaxTotalCUDepth());   // 4 with the CTC configs
+  if (minPartSize % FIELD_GRID != 0)
+  {
+    fail("--MVFieldDumpFile needs a minimum partition size that is a multiple of 4");
+  }
+  const TComPicSym* picSym      = pic->getPicSym();
+  const UInt numParts           = picSym->getNumPartitionsInCtu();
+  const UInt numPartsInCtuWidth = picSym->getNumPartInCtuWidth();
+  const Int  numRefs = (m_cfg.mvRefs == "all") ? slice->getNumRefIdx(REF_PIC_LIST_0) : 1;
+
+  std::vector<UChar> entry(8 + size_t(gridW) * gridH * 6);
+  for (Int refIdx = 0; refIdx < numRefs; refIdx++)
+  {
+    std::fill(entry.begin(), entry.end(), UChar(0));
+    putI32(&entry[0], slice->getPOC());
+    putI32(&entry[4], slice->getRefPOC(REF_PIC_LIST_0, refIdx));
+
+    for (UInt ctuRsAddr = 0; ctuRsAddr < picSym->getNumberOfCtusInFrame(); ctuRsAddr++)
+    {
+      const TComDataCU* ctu = pic->getCtu(ctuRsAddr);
+      const TComCUMvField* mvField = ctu->getCUMvField(REF_PIC_LIST_0);
+      for (UInt absPartIdx = 0; absPartIdx < numParts; absPartIdx++)
+      {
+        const UInt raster = g_auiZscanToRaster[absPartIdx];
+        const Int  px = Int(ctu->getCUPelX()) + Int(raster % numPartsInCtuWidth) * minPartSize;
+        const Int  py = Int(ctu->getCUPelY()) + Int(raster / numPartsInCtuWidth) * minPartSize;
+        if (px >= width || py >= height)
+        {
+          continue;   // part of a CTU outside the picture
+        }
+        if (ctu->isIntra(absPartIdx) || mvField->getRefIdx(absPartIdx) != refIdx)
+        {
+          continue;   // no vector for this reference picture: confidence stays 0
+        }
+        const TComMv& mv = mvField->getMv(absPartIdx);
+        for (Int cy = py / FIELD_GRID; cy < std::min(gridH, (py + minPartSize) / FIELD_GRID); cy++)
+        {
+          for (Int cx = px / FIELD_GRID; cx < std::min(gridW, (px + minPartSize) / FIELD_GRID); cx++)
+          {
+            UChar* cell = &entry[8 + (size_t(cy) * gridW + cx) * 6];
+            putI16(cell + 0, mv.getHor());
+            putI16(cell + 2, mv.getVer());
+            putI16(cell + 4, FIELD_CONF_CODED);
+          }
+        }
+      }
+    }
+    writeOrFail(m_fieldDump, &entry[0], entry.size());
+    m_fieldEntries++;
+  }
+}
