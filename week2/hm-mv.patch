+/* qnn-motion-estimation project, week 2 (not part of the HM reference software).
+ *
+ * Motion-vector I/O for HM-mv: record the encoder's motion vectors, and take motion vectors
+ * from outside. See week2/README.md of the project for the file formats and the tests built
+ * on them. With none of the options set, nothing here changes what the encoder does, and
+ * HM-mv produces the same bitstreams as HM-18.0.
+ */
+
+/** \file     TEncMvIO.h
+    \brief    motion-vector dump / replay / injection (project extension, week 2)
+*/
+
+#ifndef __TENCMVIO__
+#define __TENCMVIO__
+
+#include <cstdio>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+#include "TLibCommon/CommonDef.h"
+#include "TLibCommon/TComMv.h"
+
+class TComDataCU;
+class TComPic;
+
+//! Command-line settings of the motion-vector I/O (all off by default)
+struct MvIoConfig
+{
+  std::string meDumpFile;       ///< --MEDumpFile: one record per integer motion search
+  std::string meReplayFile;     ///< --MEReplayFile: take each integer search result from a --MEDumpFile file
+  std::string mvFieldDumpFile;  ///< --MVFieldDumpFile: final coded vectors per picture, 4x4 grid
+  std::string mvFieldFile;      ///< --MVFieldFile: external motion field (.mvf)
+  std::string mvMode;           ///< --MVMode: "replace" or "seed"
+  Bool        mvSeedCentre;     ///< --MVSeedCentre: seed mode, centre the search window on the external vector
+  std::string mvRefs;           ///< --MVRefs: "first" (reference index 0 only) or "all"
+
+  MvIoConfig() : mvSeedCentre(false), mvRefs("first") {}
+};
+
+//! Motion-vector I/O state for one encoder run (a single instance, see get())
+class TEncMvIO
+{
+public:
+  static TEncMvIO& get();
+
+  //! Check the settings and open the files; called once from TEncTop::init()
+  Void open(const MvIoConfig& cfg);
+  //! Finish and close the files, print statistics; called from TEncTop::destroy()
+  Void close();
+
+  Bool meDumpEnabled() const   { return m_meDump != NULL; }
+  Bool replayEnabled() const   { return m_replay != NULL; }
+  Bool replaceMode() const     { return m_mode == MODE_REPLACE; }
+  Bool seedMode() const        { return m_mode == MODE_SEED; }
+  Bool seedCentre() const      { return m_cfg.mvSeedCentre; }
+
+  //! --MEDumpFile: one record for a call to TEncSearch::xMotionEstimation()
+  Void writeMeRecord(const TComDataCU* cu, Int partIdx, RefPicList refList, Int refIdx, Bool bi,
+                     const TComMv& pred, const TComMv& integerMv, const TComMv& finalMv);
+
+  //! --MEReplayFile: the recorded integer search result (integer pel) for this call. The record
+  //! must describe the same call (POC, reference, block, predictor); otherwise the run stops.
+  TComMv replayIntegerMv(const TComDataCU* cu, Int partIdx, RefPicList refList, Int refIdx, Bool bi,
+                         const TComMv& pred);
+
+  //! --MVFieldFile: the external vector for this block (quarter-pel, clipped to the picture), as
+  //! the component-wise median of the valid 4x4 cells the block covers. False if the field has
+  //! no vector for this block or reference picture; HM then searches as usual.
+  Bool fieldMv(const TComDataCU* cu, Int partIdx, RefPicList refList, Int refIdx, TComMv& mv);
+
+  //! Seed mode: the vector xTZSearch() should add as a start point (quarter-pel), or NULL
+  const TComMv* seed() const   { return m_seedSet ? &m_seed : NULL; }
+  Void setSeed(const TComMv& mv) { m_seed = mv; m_seedSet = true; }
+  Void clearSeed()             { m_seedSet = false; }
+
+  //! Quarter-pel to integer pel, rounded the way HM's own search does it
+  static TComMv toIntegerPel(const TComMv& qpel);
+
+  //! --MVFieldDumpFile: final coded vectors of a picture, after it has been coded
+  Void dumpPictureField(TComPic* pic);
+
+private:
+  enum Mode { MODE_NONE, MODE_REPLACE, MODE_SEED };
+
+  TEncMvIO();
+  ~TEncMvIO();
+  TEncMvIO(const TEncMvIO&);
+  TEncMvIO& operator=(const TEncMvIO&);
+
+  Void writeFieldHeader(Int width, Int height);
+  Void loadField(const std::string& path);
+
+  MvIoConfig m_cfg;
+  Mode       m_mode;
+
+  // --MEDumpFile
+  FILE*      m_meDump;
+  UInt64     m_meRecords;
+
+  // --MEReplayFile
+  FILE*      m_replay;
+  UInt64     m_replayRecords;
+
+  // --MVFieldDumpFile
+  FILE*      m_fieldDump;
+  Bool       m_fieldHeaderDone;
+  Int        m_fieldWidth;
+  Int        m_fieldHeight;
+  UInt       m_fieldEntries;
+
+  // --MVFieldFile: (POC, reference POC) -> cells (mv_x, mv_y, confidence per 4x4 cell, raster order)
+  std::map<std::pair<Int, Int>, std::vector<Short> > m_field;
+  Int        m_inWidth;
+  Int        m_inHeight;
+  Bool       m_inSizeChecked;
+  UInt64     m_fieldHits;       ///< calls that got an external vector
+  UInt64     m_fieldMisses;     ///< eligible calls without one (no valid cell, or no entry)
+  std::vector<Short> m_medianX;
+  std::vector<Short> m_medianY;
+
+  // seed mode: the vector for the current call
+  TComMv     m_seed;
+  Bool       m_seedSet;
+};
+
+#endif // __TENCMVIO__
